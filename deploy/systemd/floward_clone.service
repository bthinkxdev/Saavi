[Unit]
Description=saavi Gunicorn daemon
After=network.target

[Service]
User=www-data
Group=www-data
RuntimeDirectory=saavi
RuntimeDirectoryMode=0755
WorkingDirectory=/var/www/saavi
EnvironmentFile=/var/www/saavi/.env
Environment=DJANGO_SETTINGS_MODULE=saavi.settings.prod
ExecStart=/var/www/saavi/.venv/bin/gunicorn \
    -c deploy/gunicorn/gunicorn.conf.py \
    saavi.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
